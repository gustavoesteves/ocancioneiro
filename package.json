{
  "name": "o-cancioneiro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "dossiers:check": "node scripts/validate-dossiers.mjs",
    "dossiers:review": "node scripts/validate-dossiers.mjs --review-dir outputs/dossiers-review",
    "dossiers:migrate": "node scripts/migrate-catalog-dossiers.mjs",
    "bridge:musescore": "node scripts/musescore-capture-bridge.mjs",
    "captures:ops": "node scripts/private-capture-ops.mjs",
    "workflow:musescore:check": "node scripts/check-musescore-workflow.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run catalog:generate",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/stage-public-assets.mjs dist/client && node scripts/verify-public-package.mjs dist/client",
    "prebuild:pages": "npm run catalog:generate",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/stage-public-assets.mjs github-pages && node scripts/verify-public-package.mjs github-pages --library-only",
    "public-assets:check": "node scripts/verify-public-package.mjs public --source-tree",
    "package:check": "node scripts/verify-public-package.mjs github-pages --library-only",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "check": "npm run catalog:check && npm run dossiers:check && npm run public-assets:check && npm run docs:check && npm run lint && npm run typecheck && npm test && npm run build:pages && npm run package:check"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "type": "module"
}
